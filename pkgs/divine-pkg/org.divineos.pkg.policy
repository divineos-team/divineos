<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>divineOS</vendor>
  <icon_name>divineos</icon_name>

  <action id="org.divineos.pkg.manage">
    <description>Install, remove and update software</description>
    <message>Authentication is required to install, remove or update software</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/divine-pkg/pkg-helper</annotate>
  </action>
</policyconfig>
