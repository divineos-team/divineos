# Maintainer: devine
# The live ISO's installer: a Quickshell window (app/) over a root backend that partitions,
# formats and copies the live system onto the disk. Only the ISO ships it.
pkgname=divine-installer
pkgver=0.1.0
pkgrel=1
pkgdesc='divineOS installer for the live ISO'
arch=(any)
license=(GPL-3.0-or-later)
depends=(
  bash sudo quickshell qt6-declarative qt6-svg inter-font ttf-nerd-fonts-symbols
  jq util-linux arch-install-scripts rsync os-prober networkmanager divine-pkg
  btrfs-progs e2fsprogs dosfstools ntfs-3g cryptsetup gparted # formatting, shrinking, manual partitioning
)

check() {
  bash "$startdir/test.sh"
}

package() {
  install -d "$pkgdir/usr/share/divine-installer"
  # no-preserve: sources may come from a Windows bind mount where every file is 0777
  cp -r --no-preserve=mode,ownership "$startdir/app/." "$pkgdir/usr/share/divine-installer/"
  install -Dm755 "$startdir/backend" -t "$pkgdir/usr/lib/divine-installer/"
  install -Dm755 "$startdir/divine-install" -t "$pkgdir/usr/bin/"
  install -Dm644 "$startdir/divine-install.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "$startdir/divine-install.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
}
