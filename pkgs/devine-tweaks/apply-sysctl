#!/usr/bin/env bash
# devine-tweaks' privileged half, run as root through pkexec (polkit action
# org.divineos.tweaks.apply-sysctl). Only allowlisted kernel settings with validated values
# are written to /etc/sysctl.d and applied.
#   apply-sysctl [--dry-run] key=value...   write and apply (or just print, with --dry-run)
#   apply-sysctl --reset                    drop all tweaks, back to divineOS defaults
set -euo pipefail

# Sorts after /usr/lib/sysctl.d/99-divineos.conf, so these values win at boot.
FILE=/etc/sysctl.d/99-z-devine-tweaks.conf

declare -A ALLOWED=(
	[vm.swappiness]='^(1?[0-9]{1,2}|200)$' # 0–200
	[vm.vfs_cache_pressure]='^[0-9]{1,3}$' # 0–999
	[net.ipv4.tcp_congestion_control]='^(bbr|cubic|reno)$'
	[fs.inotify.max_user_watches]='^[0-9]{4,7}$'
)

die() {
	echo "apply-sysctl: $*" >&2
	exit 1
}

dry=0
case ${1-} in
--reset)
	((EUID == 0)) || die "must run as root"
	rm -f "$FILE"
	sysctl --system >/dev/null
	exit
	;;
--dry-run)
	dry=1
	shift
	;;
esac
(($#)) || { echo "usage: apply-sysctl [--dry-run] key=value... | --reset" >&2; exit 2; }

body="# Written by divineOS Settings (devine-tweaks). Reset there, or delete this file."
for arg in "$@"; do
	key=${arg%%=*}
	value=${arg#*=}
	[[ $arg == *=* && -v ALLOWED[$key] && $value =~ ${ALLOWED[$key]} ]] || die "refusing '$arg'"
	body+=$'\n'"$key = $value"
done

if ((dry)); then
	echo "$body"
	exit
fi
((EUID == 0)) || die "must run as root"
echo "$body" >"$FILE.tmp"
mv "$FILE.tmp" "$FILE"
sysctl -p "$FILE"
