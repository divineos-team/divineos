{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/divineos/logo.txt",
    "color": { "1": "38;2;10;132;255", "2": "38;2;100;210;255" },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;100;210;255" }
  },
  "modules": [
    "title", "separator",
    "os", "kernel", "uptime", "packages", "shell",
    "wm", "terminal", "cpu", "gpu", "memory", "swap", "disk",
    "break", "colors"
  ]
}
