# divineOS boot splash: deep-blue gradient, breathing logo, password prompt for LUKS.

Window.SetBackgroundTopColor(0.03, 0.04, 0.10);
Window.SetBackgroundBottomColor(0.05, 0.10, 0.26);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2, 1);

t = 0;
fun refresh() {
  t++;
  logo.sprite.SetOpacity(0.65 + 0.35 * Math.Sin(t / 25));
}
Plymouth.SetRefreshFunction(refresh);

# Disk-unlock prompt: one bullet per typed character under the logo.
prompt.sprite = Sprite();
fun display_password(text, bullets) {
  s = text + "  ";
  for (i = 0; i < bullets; i++) s += "•";
  prompt.image = Image.Text(s, 0.9, 0.93, 1.0);
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetPosition(cx - prompt.image.GetWidth() / 2, cy + logo.image.GetHeight(), 2);
  prompt.sprite.SetOpacity(1);
}
fun display_normal() {
  prompt.sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
