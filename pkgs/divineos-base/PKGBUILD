# Maintainer: devine
# Installing this package turns an Arch system into divineOS:
# performance tuning, branding, boot splash, greeter and desktop defaults.
pkgname=divineos-base
pkgver=0.1.0
pkgrel=1
pkgdesc='divineOS base system: tuning, branding and divineDE defaults'
arch=(any)
license=(GPL-3.0-or-later)
depends=(
  # performance
  zram-generator ananicy-cpp
  # snapshots: Timeshift on Btrfs, listed in the boot menu (Settings > Backup)
  btrfs-progs timeshift grub-btrfs inotify-tools
  # boot + login
  plymouth greetd greetd-tuigreet sudo
  # compositor + session
  hyprland xdg-desktop-portal-hyprland hyprpolkitagent divine-shell
  pipewire pipewire-pulse wireplumber brightnessctl
  # apps
  repostation devenv divine-pkg devine-monitor devine-tweaks devine-files divine-cursors
  # interim apps until the devine suite lands
  kitty fastfetch
  # type
  inter-font ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji
)
makedepends=(git librsvg grub inter-font) # grub: grub-mkfont for the GRUB theme
backup=(etc/greetd/divineos.toml etc/ananicy.d/ananicy.conf)
install=divineos-base.install
# ponytail: tracks upstream HEAD; pin #commit= once releases need to be reproducible
source=('git+https://github.com/CachyOS/ananicy-rules.git')
sha256sums=('SKIP')

_branding="$startdir/../../branding"

build() {
  rsvg-convert -w 160 "$_branding/logo.svg" -o logo.png
  rsvg-convert -w 3840 -h 2160 "$_branding/wallpaper.svg" -o wallpaper.png
  # Tide in other colours for Settings > Appearance: dusk, ember and lagoon
  local v
  for v in dusk:70 ember:155 lagoon:-50; do
    _hue "${v#*:}" < "$_branding/wallpaper.svg" | rsvg-convert -w 3840 -h 2160 -o "${v%%:*}.png"
  done
  _grub_theme grub-theme
}

# The wallpaper SVG on stdin with its colours turned DEGREES round the colour wheel.
_hue() { # degrees
  sed -e "s|</defs>|<filter id=\"hue\" filterUnits=\"userSpaceOnUse\" x=\"0\" y=\"0\" width=\"1920\" height=\"1080\" color-interpolation-filters=\"sRGB\"><feColorMatrix type=\"hueRotate\" values=\"$1\"/></filter></defs><g filter=\"url(#hue)\">|" \
    -e 's|</svg>|</g></svg>|'
}

# The GRUB theme (branding/grub/theme.txt) and the images and fonts it names. Installed systems
# use it through /etc/default/grub (post-install); build.sh copies it onto the ISO.
_grub_theme() { # out dir
  local g=$1 r=12 i s font
  mkdir -p "$g/icons"
  cp "$_branding/grub/theme.txt" "$g/"
  # the wallpaper, dimmed so white text reads on it
  sed 's|</svg>|<rect width="1920" height="1080" fill="#070A14" fill-opacity=".5"/></svg>|' "$_branding/wallpaper.svg" |
    rsvg-convert -w 1920 -h 1080 -o "$g/background.png"
  rsvg-convert -w 560 -h 456 "$_branding/grub/panel.svg" -o "$g/panel.png"
  rsvg-convert -w 56 -h 56 "$_branding/logo.svg" -o "$g/logo.png"
  for i in "$_branding"/grub/icons/*.svg; do
    rsvg-convert -w 24 -h 24 "$i" -o "$g/icons/$(basename "$i" .svg).png"
  done
  # entry icons go by --class: grub-mkconfig tags divineOS with GRUB_DISTRIBUTOR, then arch
  for i in divineos arch; do
    rsvg-convert -w 24 -h 24 "$_branding/logo.svg" -o "$g/icons/$i.png"
  done
  # the highlight behind the chosen entry: a rounded glass pill in GRUB's nine slices
  _slice() { # name width height shape
    printf '<svg xmlns="http://www.w3.org/2000/svg" width="%s" height="%s" fill="#fff" fill-opacity=".16">%s</svg>' "$2" "$3" "$4" |
      rsvg-convert -o "$g/select_$1.png"
  }
  _slice nw $r $r "<path d='M0 ${r}A$r $r 0 0 1 $r 0V${r}Z'/>"
  _slice ne $r $r "<path d='M0 0A$r $r 0 0 1 $r ${r}H0Z'/>"
  _slice se $r $r "<path d='M$r 0A$r $r 0 0 1 0 ${r}V0Z'/>"
  _slice sw $r $r "<path d='M$r ${r}A$r $r 0 0 1 0 0H${r}Z'/>"
  _slice n 1 $r "<rect width='1' height='$r'/>"
  _slice s 1 $r "<rect width='1' height='$r'/>"
  _slice w $r 1 "<rect width='$r' height='1'/>"
  _slice e $r 1 "<rect width='$r' height='1'/>"
  _slice c 1 1 "<rect width='1' height='1'/>"
  # theme.txt asks for "Inter Regular <size>"
  font=$(fc-match -f '%{file}' 'Inter:style=Regular')
  for s in 14 16 20 32; do
    grub-mkfont -n Inter -s "$s" -o "$g/inter-$s.pf2" "$font"
  done
}

check() {
  bash "$startdir/test.sh"
}

package() {
  # no-preserve: sources may come from a Windows bind mount where every file is 0777
  cp -r --no-preserve=mode,ownership "$startdir/root/." "$pkgdir/"

  install -Dm644 logo.png -t "$pkgdir/usr/share/plymouth/themes/divineos/"
  install -Dm644 wallpaper.png "$pkgdir/usr/share/backgrounds/divineos/default.png"
  install -Dm644 dusk.png ember.png lagoon.png -t "$pkgdir/usr/share/backgrounds/divineos/"
  install -Dm644 "$_branding/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/divineos.svg"
  install -Dm644 "$_branding/logo.txt" -t "$pkgdir/usr/share/divineos/"
  install -Dm755 "$startdir/post-install" -t "$pkgdir/usr/lib/divineos/" # run by divine-install
  install -Dm755 "$startdir/snapshot" -t "$pkgdir/usr/lib/divineos/" # run by 05-divineos-snapshot.hook
  install -d "$pkgdir/usr/share/grub/themes"
  cp -r --no-preserve=ownership grub-theme "$pkgdir/usr/share/grub/themes/divineos"

  # The hosted [divine] repo, when build.sh was given one: where installed systems update from,
  # and the key that signs it (pacman-key --populate divineos).
  if [[ -n ${DIVINE_REPO_URL:-} && -f ${DIVINE_REPO_KEY:-} ]]; then
    local keys="$pkgdir/usr/share/pacman/keyrings"
    printf 'Server = %s\n' "$DIVINE_REPO_URL" | install -Dm644 /dev/stdin "$pkgdir/etc/pacman.d/divine-mirrorlist"
    install -Dm644 "$DIVINE_REPO_KEY" "$keys/divineos.gpg"
    gpg --show-keys --with-colons "$DIVINE_REPO_KEY" | awk -F: '$1 == "fpr" { print $10 ":4:"; exit }' > "$keys/divineos-trusted"
    touch "$keys/divineos-revoked"
  fi

  # CachyOS process rules for ananicy-cpp (it ships none of its own)
  install -d "$pkgdir/etc/ananicy.d"
  cp -r ananicy-rules/* "$pkgdir/etc/ananicy.d/"
  rm -f "$pkgdir/etc/ananicy.d/"{LICENSE,README.md}
  install -Dm644 ananicy-rules/LICENSE "$pkgdir/usr/share/licenses/$pkgname/ananicy-rules.LICENSE"
}
